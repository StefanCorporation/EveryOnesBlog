<%- include('../partials/header.ejs') %>


<div class="container mt-3 animate__animated animate__slideInLeft">
    <div class="card bg-color">
    <div class="card-header header-color mulan" style="color: blanchedalmond;">
        Achievment !
    </div>
    <div class="card-body shadow-lg">
        <figure>
        <blockquote class="blockquote">
            <p class="glitchText nier-font mulan" data-target="In the silence between battles, 
                I find the weight and grace of what it means to exist alongside you.">"
                In the silence between battles, 
                I find the weight and grace of what it means to exist alongside you."</p>
        </blockquote>
        <figcaption class="blockquote-footer">
            chat <cite title="Source Title">GPT</cite>
        </figcaption>
        </figure>
    </div>
    </div>
</div>

<div class="container text-center">
  <div class="row">
    <div class="col">
        <div class="container text-center mt-5 mb-5" data-bs-toggle="modal" data-bs-target="#createPostModal">
        <!-- This button is From Uiverse.io by Wlidha09 --> 
        <button class="btn-slice" href="#">
        <div class="top"><span>SAY SOMETHING 📯</span></div>
        <div class="bottom"><span>SAY SOMETHING 📯</span></div>
        </button>
    </div>
  </div>
</div>


<!-- Modal -->
<div class="modal fade" id="createPostModal" tabindex="-1" aria-labelledby="createPostModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <!-- Убрали modal-lg -->
    <div class="modal-content">

      <!-- Header -->
      <div class="modal-header header-color">
        <h5 class="modal-title fw-bold mulan" id="createPostModalLabel" style="color: blanchedalmond;">Create Post</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Body -->
      <div class="modal-body bg-color">

        <!-- User info -->
        <div class="d-flex align-items-center mb-3">
           <img src="<%= user?.profilePicture || '/images/favico.png' %>" class="rounded-circle me-2 flex-shrink-0" alt="profile" width="45" height="45">
          <div>
            <div class="fw-bold" alt="">
              <%= user ? (user.firstname + ' ' + user.lastname).trim() || user.username : 'Guest' %>
            </div>
            <small class="text-muted">Public</small>
          </div>
        </div>



      <form action="/EveryOnesBlog/create-post" method="post" enctype="multipart/form-data">

                <!-- Title Field (NEW - REQUIRED) -->
      <input type="text"
         name="title"
         class="form-control mb-3"
         placeholder="Give your post a title..."
         required
         style="background: rgba(255,255,255,0.1); border: none; color: white;">




        <!-- Textarea -->
        <textarea class="form-control border-1 mb-3" id="postText" 
          name="content"  rows="5" placeholder="What's on your mind?" style="resize: none;"></textarea>

        <!-- Image upload -->
        <div class="upload-wrap mb-3 mx-auto">
          <div id="imageUploadBox" class="nier-upload d-inline-block" role="button" tabindex="0" aria-label="Upload file">
            <div class="glitch-bar left" aria-hidden="true"></div>
            <div class="glitch-bar mid" aria-hidden="true"></div>
            <div class="glitch-bar right" aria-hidden="true"></div>

            <div class="label" style="position:relative; z-index:2;">
              <div class="icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 5 17 10"></polyline>
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                </svg>
              </div>
              <div>
                Upload Image/Video
                <div class="meta">.png .jpg .webp — max 5MB</div>
              </div>
            </div>
          </div>

          <div class="sub d-block mt-2">• Click to choose file</div>

          <!-- Hidden file input -->
          <input type="file" id="postImage" name="image" accept="image/*,video/*" class="d-none" />

          <!-- Preview -->
          <div class="mt-3 d-none" id="previewContainer">
            <img id="previewImg" class="img-fluid rounded shadow" alt="Preview" style="max-height: 400px; width: 100%; object-fit: cover;">
            <button type="button" class="btn-close position-absolute top-0 end-0 m-2 bg-white rounded-circle" onclick="removePreview()"></button>
          </div>
        </div>

        </div>
      
        <!-- Footer -->
        <div class="modal-footer bg-color justify-content-center">
          <button type="submit" class="btn-slice px-5 py-3" id="postButton">
            <div class="top"><span>Post 📬</span></div>
            <div class="bottom"><span>Post 📬</span></div>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>


<!--Content-->
<!-- Dynamic Posts Feed -->
<div class="container mt-5">
    <% const postList = posts || []; %>
    <% if (postList.length > 0) { %>
        <% postList.forEach(post => { %>
            <div class="card mb-4 shadow-lg border-0 bg-color">
                <!-- Author Info -->
                <div class="card-header header-color d-flex align-items-center border-0">
                    <img src="<%= post.author.profilePicture || '/uploads/usersAvatars/default-avatar.png' %>"
                         class="rounded-circle me-3"
                         alt="<%= post.author.username %>"
                         width="50"
                         height="50"
                         style="object-fit: cover; border: 2px solid #fff;">
                    <div>
                        <div class="fw-bold mulan" style="color: blanchedalmond;">
                            <%= post.author.firstname %> <%= post.author.lastname %>
                            <span class="text-muted small">(@<%= post.author.username %>)</span>
                        </div>
                        <small class="text-muted">
                            <%= new Date(post.createdAt).toLocaleDateString('en-US', { 
                                year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                            }) %>
                        </small>
                    </div>
                </div>

                <!-- Post Image (if exists) -->
                <% if (post.image) { %>
                    <img src="<%= post.image %>" 
                         class="card-img-top" 
                         alt="Post image"
                         style="max-height: 600px; object-fit: cover;">
                <% } %>

                <!-- Post Content -->
                <div class="card-body">
                    <h5 class="card-title mulan glitchText"><%= post.title %></h5>
                    <p class="card-text nier-font" style="font-size: 1.1rem; line-height: 1.8;">
                        <%= post.content %>
                    </p>

                    <!-- Like & Comment Buttons (you can expand later) -->
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <button class="btn btn-outline-primary btn-sm">
                            ❤️ <%= posts.likes ? post.likes.length : 0 %> Likes
                        </button>
                        <button class="btn btn-outline-secondary btn-sm">
                            💬 Comments
                        </button>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="text-center mt-5">
            <h3 class="mulan glitchText text-muted">No posts yet...</h3>
            <p>Be the first to say something! 📯</p>
        </div>
    <% } %>



