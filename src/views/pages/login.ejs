<%- include('../partials/headerForLogin.ejs') %>



    <div class="container text-center mt-5">
        <h1 class="mulan glitchText">Login</h1>
    </div>




<div class="container mt-3 centered">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
                <form class="row g-3">
                    <div class="col-12 mt-5">
                        <label for="inputUsername" class="form-label mulan glitchText formFontSize">Username *</label>
                        <input type="text" class="form-control" id="inputUsername" name="username" placeholder="Enter username" requred>
                    </div>
                    <div class="col-12 mt-5">
                        <label for="inputEmail" class="form-label mulan glitchText formFontSize">Email *</label>
                        <input type="email" class="form-control" id="inputEmail" name="email" placeholder="user@gmail.com" requred>
                    </div>
                    <div class="col-12 mt-5">
                        <label for="inputPassword1" class="form-label mulan glitchText formFontSize">Password...*</label>
                        <input type="password" class="form-control" id="inputPassword1" name="password" placeholder="Enter password"
                            required>
                    </div>



                    <div class="container text-center mt-5 mb-5">
                    <!-- This button is From Uiverse.io by Wlidha09 --> 
                    <button class="btn-slice" href="#">
                    <div class="top"><span>SUBMIT</span></div>
                    <div class="bottom"><span>SUBMIT</span></div>
                    </button>       
                </form>

            <div class="text-center mt-5">
                <p class="mulan ">Doesen't have an account? 
                    <a href="/EveryOnesBlog/registration" class="text-decoration-underline">Sign up here</a>
                </p>
            </div>
        </div>  
    </div>
 </div>




    </div>


