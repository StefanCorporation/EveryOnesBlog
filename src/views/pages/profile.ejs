<%- include('../partials/headerForLogin.ejs') %>

<link rel="stylesheet" href="/CSS/carousel.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<div class="container text-center mt-5">
    <h1 class="mulan glitchText">Profile</h1>
</div>





<div class="container text-center mt-3 mb-2">
    <div class="row">
        <div class="col">
            <div class="card mx-auto bg-color shadow-lg" style="width: 18rem;">


           
            <img src="<%= user.profilePicture || '/images/rab.png' %>"
                    class="card-img-top avatarSize shadow-lg"
                    alt="User Avatar"
                    id="currentAvatar">

            <div class="card-body cardCorrect">

            <!-- Success Message -->
                    <% if (success) { %>
                        <div class="alert alert-success"><%= success %></div>
                    <% } %>
                    
            <!-- Error Message -->
                    <% if (errors.general) { %>
                        <div class="alert alert-danger"><%= errors.general %></div>
                    <% } %>       
                    
                    
                <form class="row g-3" action="/EveryOnesBlog/profile" method="post"  enctype="multipart/form-data">
                    <div class="upload-wrap">
                        <div id="btn" class="nier-upload" role="button" tabindex="0" aria-label="Upload file">
                        <div class="glitch-bar left" aria-hidden="true"></div>
                        <div class="glitch-bar mid" aria-hidden="true"></div>
                        <div class="glitch-bar right" aria-hidden="true"></div>

                        <div class="label" style="position:relative;z-index:2;">
                            <div class="icon" aria-hidden="true">
                            <!-- minimal upload glyph (SVG) -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color:var(--accent)">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 5 17 10"></polyline>
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                            </svg>
                            </div>

                            <div>
                            Upload Avatar
                            <div class="meta">.png .jpg .webp — max 5MB</div>
                            </div>
                        </div>
                        </div>

                        <!-- <div class="sub">Hover to animate • Click to choose file</div> -->

                        <!-- hidden file input -->
                        <input type="file" id="fileInput" accept="image/*"  name="avatar"/>

                        <div id="preview" class="preview" style="display:none;">
                        <img id="previewImg" alt="preview" />
                        </div>
                    </div>


                    <div class="col-12">
                        <input type="text" class="form-control" name="firstname" value="<%= user.firstname %>"
                            id="inputFirstName" placeholder="First Name *" requred>
                    </div>
                    <div class="col-12">
                        <input type="text" class="form-control" name="lastname" value="<%= user.lastname %>"
                            id="inputLastName" placeholder="Last Name *" requred>
                    </div>
                    <div class="col-12">
                        <input type="text" class="form-control" name="username" value="<%= user.username %>"
                        id="inputUsername" placeholder="Username *" requred>
                    </div>
                    <div class="col-12">
                        <input type="email" class="form-control" name="email" value="<%= user.email %>"
                        id="inputEmail" placeholder="user@gmail.com" requred>
                    </div>

                    <div class="container text-center mt-5 mb-5">
                    <!-- This button is From Uiverse.io by Wlidha09 --> 
                    <button class="btn-slice" type="submit">
                            <div class="top"><span>SUBMIT</span></div>
                            <div class="bottom"><span>SUBMIT</span></div>
                        </button>
                    </div>

                </form>
            </div>
        </div>
        </div>

        <div class="col-8 ">
            <div class="card mb-3 bg-color shadow-lg">
            <div class="card bg-color shadow-lg">
            <div class="card-body bg-color shadow-lg">
                <h5 class="card-title">My title</h5>

            </div>
            <img src="/uploads/usersBackgroundImages/banner.png" class="card-img-bottom" alt="...">
            </div>
        </div>

        <div class="col-sm-12 albumCorrect animate__animated animate__slideInUp">
            <ul class="nav justify-content-center">
                <li class="nav-item">
                    <a class="nav-link text-secondary-emphasis  glitchText" aria-current="page" href="/EveryOnesBlog">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary-emphasis  glitchText" href="#">Link</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary-emphasis  glitchText" href="#">Link</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-secondary-emphasis  glitchText" href="logout">Logout</a>
                </li>
            </ul>
            
            <h1 class="mulan glitchText" data-target="My Posts">My Posts</h1>

        </div>


<div class="container mt-5">
    <h1 class="mulan glitchText text-center mb-5">My Posts</h1>

    <% const postList = posts || []; %>
    <% if (postList.length > 0) { %>
        <% postList.forEach(post => { %>
            <div class="card mb-4 shadow-lg border-0 bg-color">
                <!-- Same card as homepage -->
                <div class="card-header header-color d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <img src="<%= user.profilePicture || '/uploads/usersAvatars/default-avatar.png' %>"
                             class="rounded-circle me-3"
                             width="50" height="50">
                        <div>
                            <div class="fw-bold mulan" style="color: blanchedalmond;">
                                Me (@<%= user.username %>)
                            </div>
                            <small class="text-muted">
                                <%= new Date(post.createdAt).toLocaleDateString() %>
                            </small>
                        </div>
                    </div>

                    <!-- Edit & Delete Buttons (ONLY for own posts) -->
                    <div>
                        <a href="/EveryOnesBlog/edit-post/<%= post._id %>" class="btn btn-sm btn-warning">Edit</a>
                        <form action="/EveryOnesBlog/delete-post/<%= post._id %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger" 
                                    onclick="return confirm('Delete this post?')">Delete</button>
                        </form>
                    </div>
                </div>

                <% if (post.image) { %>
                    <img src="<%= post.image %>" class="card-img-top" style="max-height: 500px; object-fit: cover;">
                <% } %>

                <div class="card-body">
                    <h5 class="card-title mulan glitchText"><%= post.title %></h5>
                    <p class="card-text nier-font"><%= post.content %></p>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="text-center mt-5">
            <h3 class="mulan glitchText text-muted">You haven't posted anything yet!</h3>
            <a href="/EveryOnesBlog" class="btn-slice mt-3">
                <div class="top"><span>Create Your First Post 📯</span></div>
                <div class="bottom"><span>Create Your First Post 📯</span></div>
            </a>
        </div>
    <% } %>
</div>




    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
<script src="/JS/awesomeUpload.js"></script>
<script src="/JS/profile.js"></script>
<script src="/JS/carousel.js"></script>




















<%- include('../partials/footerForLogin.ejs') %>